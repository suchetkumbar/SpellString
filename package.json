{
  "name": "spellstring",
  "version": "1.0.0",
  "description": "Spellstring: an ASCII falling-sand roguelite where spells are written in the world's alphabet.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
